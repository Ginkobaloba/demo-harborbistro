# Stripe (chunk 3.7). Test mode only.
#
# The placeholder below deliberately does NOT start with `sk_test_`: checkStripeTestMode()
# in src/lib/stripe-mode.ts requires that prefix, so this value is refused (checkout
# answers 503) instead of being accepted as a syntactically-plausible key that only fails
# once it actually calls the Stripe API.
STRIPE_SECRET_KEY=REPLACE-WITH-STRIPE-TEST-SECRET-KEY
# Required for /api/webhooks/stripe to process anything. Without it the
# webhook fails closed (503) and orders reconcile only on the confirmation
# page. Local dev: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# prints a whsec_ for this value. See README "Stripe webhook".
#
# Left EMPTY on purpose: getWebhookSecret() in src/lib/stripe.ts has no length or format
# check, only a truthy check, so any non-empty placeholder (even one that looks obviously
# fake, like the old `whsec_xxx`) would be accepted as a working HMAC key for verifying
# inbound Stripe webhook signatures -- a forgeable, publicly-known signing secret. Empty is
# the only value that reliably fails closed here.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Test mode is enforced: checkout refuses any secret key that is not sk_test_
# and any publishable key that is set but not pk_test_ (src/lib/stripe-mode.ts).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is intentionally public (shipped to the browser by
# design), so pk_test_xxx above is left as-is; it is not a signing secret.

# Visitor-data retention (docs/decisions.md D-016). Visitor-created orders and
# reservations are deleted after 24h. Set to 1 only in tests to switch the
# automatic purge off.
# HARBOR_RETENTION_DISABLED=1

# Paradigm Portal federation (chunk 4b).
# See portal-shell/docs/PORTAL_GATE_CONTRACT.md.
PORTAL_JWKS_URL=https://portal.paradigm.codes/.well-known/jwks.json
PORTAL_EXPECTED_ISSUER=https://auth.paradigm.codes
PORTAL_EXPECTED_AUD=harborbistro

# Verifier engine (CA5 cutover). Default is the shared @paradigm-codes/auth
# library. Set to `bespoke` to roll back to the pre-CA5 in-repo verifier
# without a code change. This flag (and the bespoke module) are removed one
# release after the shared engine ships clean.
# PORTAL_VERIFIER=bespoke

# REQUIRED. Signs the hb_visitor cookie (docs/decisions.md D-018) and the
# portal session cookie. At least 32 chars of high-entropy random. Without a
# usable value (this placeholder is refused), online ordering and
# reservations answer 503 and no visitor cookie is issued.
#
# The placeholder below is deliberately SHORTER than 32 characters: it fails
# sessionSecretProblem()'s length rule outright (src/lib/session-secret.ts), so a
# deploy that ships this file verbatim fails closed. The previous placeholder was
# 31 characters -- one character short of the 32-char floor -- and was caught only
# by an exact-string denylist; this one is well clear of the line on length alone.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=REPLACE-BEFORE-DEPLOY
